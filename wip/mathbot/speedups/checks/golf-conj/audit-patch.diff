+/** AUDIT ONLY (mathbot scratch copy, not the app): eml with the principal log. */
+export function emlPrincipal(x: C, y: C): C {
+  const a = cexp(x);
+  const b = clogPrincipal(y);
+  const re = cancelled(a.re - b.re, a.re, b.re);
+  const im = cancelled(a.im - b.im, a.im, b.im);
+  if (Number.isNaN(re) || Number.isNaN(im)) return { re: NaN, im: NaN };
+  return { re, im };
